# n8n-side environment contract. Set these in your n8n instance, not in the app.
# The app's own .env.example is unchanged — nothing here belongs in the Next.js
# build, and none of these are ever read by product code.

# --------------------------------------------------------------- required

# n8n refuses $env access inside expressions unless this is false. Without it
# every expression resolves to undefined and workflows try to email `undefined`.
# The single most common setup mistake.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# No trailing slash. Every link in every email is built from this.
AMANTRIKA_SITE_URL=https://amantrika.com

# Must be a verified Resend sending domain. src/lib/env.ts defaults the app to
# `Amantrika <onboarding@resend.dev>`, which only delivers to the Resend account
# owner — fine for the owner alerts, silently useless for workflows 05-10.
AMANTRIKA_EMAIL_FROM=Amantrika <hello@amantrika.com>

# Where owner alerts land when WhatsApp is unavailable, and where the daily
# digest goes. Matches the admin_allowlist seed in the core migration.
AMANTRIKA_OWNER_EMAIL=theamantrika@gmail.com

# --------------------------------------------------------------- safety

# true  -> nothing is sent. The ledger row is closed as `skipped` with the fully
#          rendered email in `payload`, so a dry run doubles as a proofreading
#          pass. Leave this true until you have run every workflow twice and
#          confirmed the second run produces zero new rows.
# false -> live.
AMANTRIKA_DRY_RUN=true

# --------------------------------------------------------------- whatsapp

# Owner alerts only, over the official Meta Cloud API, to your own number.
# Guests are never messaged on WhatsApp — project-overview.md §18 forbids
# unofficial automation, and the deep links in workflow 07 send nothing by
# themselves.
#
# Every owner workflow falls back to email automatically if any of this is
# missing or the call fails, so they are useful before Meta approves anything.

# Meta Business -> WhatsApp -> API Setup -> Phone number ID (a number, not the
# phone number itself).
AMANTRIKA_WA_PHONE_NUMBER_ID=

# E.164 without the + — e.g. 919876543210 for an Indian mobile.
AMANTRIKA_OWNER_WHATSAPP=

# An APPROVED template, category Utility, with exactly one body variable:
#   Amantrika: {{1}}
# Template parameters cannot contain newlines, which is why each render node
# produces a single-line `whatsapp` string alongside the HTML.
AMANTRIKA_WA_TEMPLATE=amantrika_ops_alert

# --------------------------------------------------------------- optional

# RFC 8058 List-Unsubscribe target. There is no /unsubscribe route in the app
# yet, so this is a real mailbox you watch, and you insert into
# automation.optouts by hand. See "Known limitations" in README.md.
AMANTRIKA_UNSUBSCRIBE_MAILBOX=unsubscribe@amantrika.com

# --------------------------------------------------------------- self-hosting
#
# Only needed with docker-compose.yml (DEPLOYMENT.md option C). Managed hosts
# (n8n Cloud, Railway, Render) set these themselves.

# Password for n8n's OWN Postgres — its workflows, credentials and execution
# history. Not your Amantrika database.
N8N_DB_PASSWORD=

# Encrypts stored credentials: openssl rand -hex 32
# Generate once, keep it safe, never change it.
N8N_ENCRYPTION_KEY=

N8N_HOST=n8n.amantrika.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.amantrika.com/

# --------------------------------------------------------------- credentials
#
# NOT environment variables. Create these in n8n's credential store with
# exactly these names — the workflow JSON references them by name:
#
#   Amantrika Supabase (Postgres)  Postgres      session pooler, port 5432
#   Resend API                     Header Auth   Authorization: Bearer re_...
#   Meta WhatsApp Cloud            Header Auth   Authorization: Bearer <token>
#
# The Postgres user must bypass RLS. A restricted role returns empty result sets
# and every workflow silently finds nothing.
