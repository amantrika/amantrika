{"type":"route","meta":{"status":200,"headers":{"cache-control":"public, immutable, no-transform, max-age=31536000","content-type":"image/svg+xml","x-next-cache-tags":"_N_T_/layout,_N_T_/icon.svg/layout,_N_T_/icon.svg/route,_N_T_/icon.svg"}},"body":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 32 32\" width=\"32\" height=\"32\">\n  <!--\n    Favicon. Next serves this from the app directory as the site icon.\n\n    Deliberately heavier than public/brand/amantrika-mark.svg: at 16px the\n    display weight of the real mark thins out to nothing, so the strokes are\n    fattened and the optical margin cut. Keep the two files in step in shape,\n    not in numbers.\n\n    Colours are declared inline because a favicon has no page cascade to\n    inherit from — change them here when the brand colours change.\n  -->\n  <style>\n    svg { --logo-ink: #6b1f2a; --logo-accent: #c9a227; }\n    /* Maroon on a dark tab strip is a smudge; ivory reads. */\n    @media (prefers-color-scheme: dark) { svg { --logo-ink: #f7e7c6; } }\n  </style>\n  <path d=\"M4.5 28 L11.8 10.6 A4.4 4.4 0 0 1 20.2 10.6 L27.5 28\"\n        fill=\"none\" stroke=\"var(--logo-ink)\" stroke-width=\"3.2\"\n        stroke-linecap=\"round\" stroke-linejoin=\"round\" />\n  <path d=\"M9 21.5 H23\" fill=\"none\" stroke=\"var(--logo-accent)\" stroke-width=\"3\" stroke-linecap=\"round\" />\n  <circle cx=\"16\" cy=\"4.8\" r=\"2.8\" fill=\"var(--logo-accent)\" />\n</svg>\n"}