# ---- AWS ----
# The migration off Supabase/Vercel is in progress; see aws/STATUS.md for what
# actually exists. Nothing below is a credential: access comes from the IAM role
# the code runs as (the Lambda execution role in production, your `aws login`
# session locally), which is why there is no equivalent of the service-role key.
AWS_REGION=ap-southeast-1

# The single DynamoDB table. See aws/DATA-MODEL.md before writing any query.
AMANTRIKA_TABLE=amantrika

# Cognito. The client was created *with* a secret, making it a confidential
# client — so COGNITO_CLIENT_SECRET is server-only and must never be NEXT_PUBLIC_.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=

# ---- Supabase ----
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — never expose to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# ---- App ----
# Public origin, used for invite links, OAuth redirects and OG images.
NEXT_PUBLIC_SITE_URL=https://amantrika.imswarnil.com

# ---- Cloudinary (theme gallery images) ----
# Cloud name only, and it is publishable — the browser fetches the images. The
# `atheme` rows store delivery paths without it, so moving accounts is a change
# here rather than an UPDATE over every row. Unset = the gallery section is
# omitted and the rest of the site is unaffected. The Cloudinary API secret is
# not used by this app and must never be added.
NEXT_PUBLIC_CLOUDINARY_CLOUD=dxedclcqu

# ---- Payments ----
# Which implementation getPaymentProvider() returns: 'mock' | 'dodo'.
PAYMENT_PROVIDER=mock

# Server-only. The mock provider signs its webhooks with this, so the mock
# exercises the same signature check Dodo does. Any long random string.
PAYMENT_WEBHOOK_SECRET=

# 'true' exposes /checkout/mock in production. It is a free-invitation button —
# leave it unset.
ALLOW_MOCK_PAYMENTS=

# Server-only. Test and live are separate businesses with separate catalogues.
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_ENVIRONMENT=test_mode

# The early-bird discount ladder (project-overview.md §14) stays off until real
# list prices are set — 40% off a placeholder helps nobody.
PRICING_EARLY_BIRD=false

# ---- Email (Resend) ----
# Server-only. Create a sending-only key at resend.com/api-keys.
RESEND_API_KEY=

# Sender for all transactional mail. Must be on a domain verified in Resend.
# `onboarding@resend.dev` needs no DNS but only delivers to the Resend account
# owner — use it for local testing, never in production.
EMAIL_FROM="Amantrika <onboarding@resend.dev>"

# Server-only. Guards /api/cron/*. Any long random string;
# `openssl rand -hex 32` is fine.
CRON_SECRET=

# ---- PostHog (product analytics + server logs) ----
# The phc_ project token is publishable: it ships in the client bundle and can
# only write events. Browser traffic is proxied through /ingest (see
# next.config.ts) so content blockers don't drop it.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
